# ==========================================
# RESQ AI - Backend Environment Variables
# ==========================================

# 1. Project Configuration
PROJECT_NAME="RESQ AI Backend"
DEBUG=True
ENVIRONMENT="development"

# 2. CORS Configuration
# A comma-separated list of allowed origins.
# For local frontend development, use http://localhost:3000
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# 3. Google Gemini API Key
# Required for the LangGraph agentic AI workflow (triage, observations, etc.)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY="your_google_gemini_api_key_here"

# 4. Google Maps Platform API Key
# Required for the Hospital Location Search agent (Places API & Geocoding)
# Get your API key from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# 5. Database URL (Optional)
# By default, the system uses SQLite and automatically creates 'resq_ai.db'.
# If you wish to use PostgreSQL, provide the connection string here:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/resqai"
